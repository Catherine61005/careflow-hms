digraph S { rankdir=LR; graph [fontname="Helvetica", label="Implemented relational schema (PostgreSQL, schema hms)", labelloc=t, fontsize=18, nodesep=0.3, ranksep=1.0]; node [shape=plaintext, fontname="Helvetica", fontsize=10]; edge [color="#667085", arrowhead=crow, arrowtail=none];
"admission" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#98a2b3"><TR><TD COLSPAN="2" BGCOLOR="#e6f4f2"><B>ADMISSION</B></TD></TR><TR><TD ALIGN="LEFT" PORT="admission_id"><U><B>admission_id</B></U></TD><TD ALIGN="LEFT"><FONT COLOR="#667085">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="patient_id">patient_id (FK)</TD><TD ALIGN="LEFT"><FONT COLOR="#667085">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="doctor_id">doctor_id (FK)</TD><TD ALIGN="LEFT"><FONT COLOR="#667085">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="admission_date">admission_date</TD><TD ALIGN="LEFT"><FONT COLOR="#667085">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="discharge_date">discharge_date</TD><TD ALIGN="LEFT"><FONT COLOR="#667085">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="reason">reason</TD><TD ALIGN="LEFT"><FONT COLOR="#667085">text</FONT></TD></TR></TABLE>>];

graph ER {
layout=neato; overlap=false; splines=true; sep="+14"; esep="+6"; pad=0.4; outputorder=edgesfirst;
labelloc=t; fontsize=26; fontname="Helvetica-Bold"; label="ER Diagram - Hospital Management System (CareFlow HMS)";
node [fontname="Helvetica", fontsize=11]; edge [fontname="Helvetica-Bold", fontsize=12, len=1.2];
"HOSPITAL" [shape=box, style="filled,bold", fillcolor="#dbe9ff", fontsize=13, fontname="Helvetica-Bold"];
"HOSPITAL.Hospital_ID" [shape=ellipse, label=<<U>Hospital_ID</U>>, fillcolor="#fff7e0", style="filled"];
"HOSPITAL" -- "HOSPITAL.Hospital_ID" [len=0.9];
"HOSPITAL.Hospital_Name" [shape=ellipse, label="Hospital_Name", fillcolor="#fff7e0", style="filled"];
"HOSPITAL" -- "HOSPITAL.Hospital_Name" [len=0.9];
"HOSPITAL.Location" [shape=ellipse, label="Location", fillcolor="#fff7e0", style="filled"];
"HOSPITAL" -- "HOSPITAL.Location" [len=0.9];
"HOSPITAL.Contact_Number" [shape=ellipse, label="Contact_Number", fillcolor="#fff7e0", style="filled"];
"HOSPITAL" -- "HOSPITAL.Contact_Number" [len=0.9];

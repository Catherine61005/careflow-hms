# Copy to .env.local and fill in. NEVER commit .env.local.
# The app connects as the least-privilege role hms_app (created by db/04_roles.sql)
DATABASE_URL=postgres://hms_app:change_me@localhost:5432/hms
# Owner/superuser connection, used only by scripts/setup-db.sh
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/hms
# Password the setup script assigns to hms_app (must match DATABASE_URL)
HMS_APP_PASSWORD=change_me
# Long random string: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret
# Embedding model (downloaded from Hugging Face on first use, ~90 MB, then cached)
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# Optional: folder with pre-downloaded models (offline use). Leave empty to download.
MODEL_PATH=
